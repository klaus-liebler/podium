<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Podium</RootNamespace>
    <AssemblyName>Podium</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.14.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Sustainsys.Saml2.AspNetCore2" Version="2.11.2" />
  </ItemGroup>

  <!-- Oberflächen-Quellen (Vite/Lit, inkl. node_modules) und Deploy-Kit gehören nicht ins .NET-Projekt;
       ausgeliefert wird nur das Build-Ergebnis in wwwroot. -->
  <ItemGroup>
    <Compile Remove="web/**;deploy/**" />
    <Content Remove="web/**;deploy/**" />
    <None Remove="web/**;deploy/**" />
    <Content Remove="*.db;*.db-*" />
  </ItemGroup>

</Project>
