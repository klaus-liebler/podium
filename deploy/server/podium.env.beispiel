# /etc/podium/podium.env – Abweichungen für Podium (root:podium, 0640). NICHT ins Repository.
# schritte/einrichten.sh legt die Datei an, falls sie fehlt. Danach: sudo systemctl restart podium
#
# Kein Admin-Passwort hier: Solange die Datenbank kein Konto enthält, zeigt
# https://liebler.iui.hs-osnabrueck.de/podium/ die Ersteinrichtung – dort das erste Admin-Konto anlegen (danach zweiter Faktor, Pflicht für Admins).
#
# Anmeldeverfahren (Kacheln auf der Anmeldeseite). Ohne Angabe: Passwort und Passkey, dazu SAML (Saml__IdpEntityId in der Unit) und
# OIDC, sobald konfiguriert.
#Anmeldung__Verfahren=Saml,Passwort,Passkey
#Anmeldung__MfaBeiSsoVerlangen=true
# OIDC (optional). Redirect-URI beim Anbieter: https://liebler.iui.hs-osnabrueck.de/podium/signin-oidc
#Oidc__Authority=
#Oidc__ClientId=
#Oidc__ClientSecret=
