# /etc/podium/podium.env – Geheimnisse und Abweichungen für Podium (root:podium, 0640). NICHT ins Repository.
# schritte/einrichten.sh legt die Datei an, falls sie fehlt. Danach: sudo systemctl restart podium

# Erstes Admin-Konto (wird nur angelegt, solange es noch KEIN Konto gibt).
# Ohne Passwort erzeugt Podium eines und schreibt es einmalig ins Journal:
#   sudo journalctl -u podium | grep "Erstes Admin-Konto"
Admin__Benutzer=admin
Admin__Name=Administration
#Admin__Passwort=
