# Podium (Live-Quiz) als systemd-Dienst – Ziel: /etc/systemd/system/podium.service (schritte/einrichten.sh)
# Linux-Build in /opt/podium (framework-abhängig: gemeinsame ASP.NET-Core-Runtime aus VibeVHS-Schritt 09; mit deploy.ps1 -MitRuntime self-contained), Daten getrennt in /var/lib/podium.
# Abweichungen/Geheimnisse stehen nur in /etc/podium/podium.env (root:podium, 0640), nie im Repository.
[Unit]
Description=Podium Live-Quiz
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=podium
Group=podium
WorkingDirectory=/opt/podium
ExecStart=/opt/podium/Podium
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

Environment=ASPNETCORE_ENVIRONMENT=Production
# Nur lokal: nach außen spricht ausschließlich nginx (https://liebler.iui.hs-osnabrueck.de/podium/)
Environment=ASPNETCORE_URLS=http://127.0.0.1:5090
Environment=PathBase=/podium
Environment=PublicBaseUrl=https://liebler.iui.hs-osnabrueck.de/podium
Environment=DbPath=/var/lib/podium/podium.db
Environment=KeysPath=/var/lib/podium/schluessel
# Hochschul-Login (SAML) über den Shibboleth-IdP der Hochschule. SP-Metadaten: …/podium/Saml2,
# Schlüssel/Zertifikat des SP: /var/lib/podium/schluessel/saml-sp.pfx (wird beim ersten Start erzeugt – nicht löschen,
# sonst muss das Rechenzentrum die Metadaten neu einlesen). Zum Abschalten die Zeile entfernen.
Environment=Saml__IdpEntityId=https://shib-idp.hs-osnabrueck.de/idp/shibboleth
Environment=HOME=/var/lib/podium
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
EnvironmentFile=-/etc/podium/podium.env

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/podium /var/backups/podium

[Install]
WantedBy=multi-user.target
